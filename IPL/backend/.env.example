# FastAPI Configuration
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
DEBUG=True
ENVIRONMENT=development

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/ipl_predictor
SQLALCHEMY_ECHO=False

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_EXPIRY=3600

# JWT Configuration
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# MLflow Configuration
MLFLOW_TRACKING_URI=./mlflow_artifacts
MLFLOW_BACKEND_STORE_URI=sqlite:///mlflow.db

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost:8081

# Model Configuration
MODEL_PATH=./models
WIN_PROBABILITY_MODEL=match_winner_xgboost.pkl
SCORE_PREDICTION_MODEL=score_lstm.h5
PLAYER_STATS_MODEL=player_stats_rf.pkl
VIEWERSHIP_MODEL=viewership_regression.pkl

# Kaggle API (for dataset download)
KAGGLE_USERNAME=your-kaggle-username
KAGGLE_KEY=your-kaggle-api-key

# Logging
LOG_LEVEL=INFO
